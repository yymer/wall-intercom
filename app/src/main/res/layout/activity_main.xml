<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Slideshow: two image views cross-fading -->
    <ImageView
        android:id="@+id/imgA"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <ImageView
        android:id="@+id/imgB"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:padding="32dp"
        android:textColor="#CCCCCC"
        android:textSize="26sp"
        android:visibility="gone" />

    <!-- Call video -->
    <org.webrtc.SurfaceViewRenderer
        android:id="@+id/remoteView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <org.webrtc.SurfaceViewRenderer
        android:id="@+id/localView"
        android:layout_width="240dp"
        android:layout_height="180dp"
        android:layout_gravity="top|end"
        android:layout_margin="24dp"
        android:visibility="gone" />

    <!-- Shown when someone touches the slideshow -->
    <FrameLayout
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#33000000"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="56dp"
            android:gravity="center"
            android:orientation="vertical">

            <!-- "… didn't answer" / "… can't answer right now" after an outgoing call -->
            <TextView
                android:id="@+id/callResult"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:gravity="center"
                android:shadowColor="#CC000000"
                android:shadowRadius="8"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:visibility="gone" />

            <!-- One row per room (Call + Bell), built in MainActivity.rebuildRooms() -->
            <LinearLayout
                android:id="@+id/roomsList"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical" />
        </LinearLayout>

        <TextView
            android:id="@+id/settingsBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:padding="20dp"
            android:shadowColor="#99000000"
            android:shadowRadius="6"
            android:text="⚙"
            android:textColor="#AAFFFFFF"
            android:textSize="28sp" />
    </FrameLayout>

    <!-- Shown during a call -->
    <LinearLayout
        android:id="@+id/callPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="40dp"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/callStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:shadowColor="#000000"
            android:shadowRadius="8"
            android:textColor="#FFFFFF"
            android:textSize="30sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Only shown while an incoming call is ringing -->
            <Button
                android:id="@+id/answerBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="32dp"
                android:background="@drawable/bg_answer"
                android:minWidth="320dp"
                android:paddingStart="40dp"
                android:paddingTop="28dp"
                android:paddingEnd="40dp"
                android:paddingBottom="28dp"
                android:text="@string/answer"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="34sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/endBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_end"
                android:minWidth="320dp"
                android:paddingStart="40dp"
                android:paddingTop="28dp"
                android:paddingEnd="40dp"
                android:paddingBottom="28dp"
                android:text="@string/end_call"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="34sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="48dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:gravity="center"
        android:background="@drawable/bg_msg"
        android:paddingStart="32dp"
        android:paddingTop="18dp"
        android:paddingEnd="32dp"
        android:paddingBottom="18dp"
        android:textColor="#FFFFFF"
        android:textSize="26sp"
        android:visibility="gone" />
</FrameLayout>
