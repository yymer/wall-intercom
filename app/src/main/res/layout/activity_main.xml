<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Slideshow: two image views cross-fading -->
    <ImageView
        android:id="@+id/imgA"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <ImageView
        android:id="@+id/imgB"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:padding="32dp"
        android:textColor="#CCCCCC"
        android:textSize="26sp"
        android:visibility="gone" />

    <!-- Call video -->
    <org.webrtc.SurfaceViewRenderer
        android:id="@+id/remoteView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <org.webrtc.SurfaceViewRenderer
        android:id="@+id/localView"
        android:layout_width="240dp"
        android:layout_height="180dp"
        android:layout_gravity="top|end"
        android:layout_margin="24dp"
        android:visibility="gone" />

    <!-- Shown when someone touches the slideshow -->
    <FrameLayout
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#33000000"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="56dp"
            android:gravity="center"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/callBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_call"
                    android:drawableStart="@drawable/ic_stat"
                    android:drawablePadding="12dp"
                    android:elevation="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="32dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="36dp"
                    android:paddingBottom="14dp"
                    android:stateListAnimator="@null"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp" />

                <Button
                    android:id="@+id/bellBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:background="@drawable/bg_bell"
                    android:drawableStart="@drawable/ic_bell"
                    android:drawablePadding="12dp"
                    android:elevation="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="32dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="36dp"
                    android:paddingBottom="14dp"
                    android:stateListAnimator="@null"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/peerStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:shadowColor="#CC000000"
                android:shadowRadius="6"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/settingsBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:padding="20dp"
            android:shadowColor="#99000000"
            android:shadowRadius="6"
            android:text="⚙"
            android:textColor="#AAFFFFFF"
            android:textSize="28sp" />
    </FrameLayout>

    <!-- Shown during a call -->
    <LinearLayout
        android:id="@+id/callPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="40dp"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/callStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:shadowColor="#000000"
            android:shadowRadius="8"
            android:textColor="#FFFFFF"
            android:textSize="30sp" />

        <Button
            android:id="@+id/endBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_end"
            android:minWidth="320dp"
            android:paddingStart="40dp"
            android:paddingTop="28dp"
            android:paddingEnd="40dp"
            android:paddingBottom="28dp"
            android:text="@string/end_call"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="34sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="48dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:gravity="center"
        android:background="@drawable/bg_msg"
        android:paddingStart="32dp"
        android:paddingTop="18dp"
        android:paddingEnd="32dp"
        android:paddingBottom="18dp"
        android:textColor="#FFFFFF"
        android:textSize="26sp"
        android:visibility="gone" />
</FrameLayout>
